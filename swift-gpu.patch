+} // end anonymous namespace
+
+// swift-metal: rewrite the printed AIR file in place to use typed pointers.
+static bool rewriteAIRFileToTypedPointers(StringRef airPath,
+                                          DiagnosticEngine &Diags) {
+  auto buf = llvm::MemoryBuffer::getFile(airPath);
+  if (!buf) {
+    Diags.diagnose(SourceLoc(), diag::error_gpu_metallib_tool_failed,
+                   "typed-pointers");
+    return true;
+  }
+  std::string rewritten = rewriteAIRToTypedPointers((*buf)->getBuffer());
+  std::error_code ec;
+  llvm::raw_fd_ostream os(airPath, ec);
+  if (ec) {
+    Diags.diagnose(SourceLoc(), diag::error_gpu_metallib_tool_failed,
+                   "typed-pointers");
+    return true;
+  }
+  os << rewritten;
+  return false;
+}
+
+static bool packageMetallib(StringRef airPath, DiagnosticEngine &Diags) {
+  auto xcrun = llvm::sys::findProgramByName("xcrun");
+  if (!xcrun) {
+    Diags.diagnose(SourceLoc(), diag::error_gpu_metallib_tool_failed, "xcrun");
+    return true;
+  }
+  auto run = [&](llvm::ArrayRef<llvm::StringRef> args) -> bool {
+    if (llvm::sys::ExecuteAndWait(*xcrun, args) != 0) {
+      Diags.diagnose(SourceLoc(), diag::error_gpu_metallib_tool_failed, args[1]);
+      return true;
+    }
+    return false;
+  };
+
+  llvm::SmallString<128> airBC;
+  if (llvm::sys::fs::createTemporaryFile("swiftgpu", "air", airBC)) {
+    Diags.diagnose(SourceLoc(), diag::error_gpu_metallib_tool_failed, "metal-as");
+    return true;
+  }
+
+  // metal-as: textual AIR -> AIR bitcode; metallib: bitcode -> loadable library
+  // (overwriting the textual output at airPath).
+  bool failed = run({"xcrun", "metal-as", airPath, "-o", airBC}) ||
+                run({"xcrun", "metallib", airBC, "-o", airPath});
+  llvm::sys::fs::remove(airBC);
+  return failed;
+}
