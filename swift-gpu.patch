 /// Perform diagnostics for func/init/deinit declarations.
+//===----------------------------------------------------------------------===//
+// swift-metal: GPU-safe subset enforcement.
+//
+// A `@Compute` kernel runs on the GPU, which has no Swift runtime: no heap, no
+// ARC, no stack for recursion, no error-box allocation, no dynamic dispatch via
+// witness tables. Writing an unsupported construct otherwise fails deep in the
+// pipeline (a SIL-verifier abort, a metal-as parse error, or a driver crash) with
+// no source location. These checks turn that into a clear diagnostic at the
+// offending expression, up front.
+//===----------------------------------------------------------------------===//
+namespace {
+
+/// True if `ty` (a value/return/local type in kernel code) requires the Swift
+/// runtime — a class (ARC), an existential (`any P` — witness tables), or a
+/// heap-backed standard type (Array/String/Dictionary/Set).
+static bool gpuUnsafeType(Type ty, StringRef &why) {
+  if (!ty || ty->hasError()) return false;
+  ty = ty->getReferenceStorageReferent();
+  if (ty->getClassOrBoundGenericClass()) {
+    why = "a class instance (needs ARC)";
+    return true;
+  }
+  if (ty->isAnyExistentialType()) {
+    why = "an existential (needs witness tables)";
+    return true;
+  }
+  if (auto *nom = ty->getAnyNominal()) {
+    StringRef n = nom->getName().str();
+    if (n == "Array" || n == "ContiguousArray" || n == "String" ||
+        n == "Substring" || n == "Dictionary" || n == "Set")
+      { why = "a heap-allocated standard-library type"; return true; }
+  }
+  return false;
+}
+
+/// Walks a kernel body flagging GPU-unsafe expressions.
+class GPUSafetyWalker : public ASTWalker {
+  DiagnosticEngine &Diags;
+  AbstractFunctionDecl *Kernel;
+  StringRef Noun;
+  llvm::SmallPtrSet<const void *, 8> Reported;
+
+  void reject(SourceLoc loc, StringRef construct, StringRef why) {
+    if (loc.isInvalid()) loc = Kernel->getLoc();
+    // One error per source location — a `let x = <unsafe>` would otherwise fire
+    // for both the variable and its initializer expression.
+    if (!Reported.insert(loc.getOpaquePointerValue()).second)
+      return;
+    Diags.diagnose(loc, diag::gpu_unsafe_construct, construct, why);
+    Diags.diagnose(Kernel->getLoc(), diag::gpu_unsafe_in_kernel, Noun,
+                   Kernel->getName());
+  }
+
+public:
+  GPUSafetyWalker(DiagnosticEngine &diags, AbstractFunctionDecl *kernel,
+                  StringRef noun)
+      : Diags(diags), Kernel(kernel), Noun(noun) {}
+
+  MacroWalking getMacroWalkingBehavior() const override {
+    return MacroWalking::Expansion;
+  }
+
+  PreWalkResult<Expr *> walkToExprPre(Expr *E) override {
+    // Checks are type-based, not syntactic: `[1,2,3,4]` as an
+    // `InlineArray`/`SIMD4` literal is GPU-safe, only as `Array` is it not
+    // (likewise a `StaticString` literal vs a `String`).
+    StringRef why;
+    // A call whose result needs the runtime (a class init, or a function
+    // returning Array/String/an existential).
+    if (auto *call = dyn_cast<ApplyExpr>(E)) {
+      if (call->getType() && gpuUnsafeType(call->getType(), why)) {
+        reject(call->getLoc(), "this value", why);
+        return Action::Continue(E);
+      }
+    }
+    // Collection / string literals — including the implicit `[Any]` varargs
+    // array that `print(...)` and friends desugar to.
+    if (isa<ArrayExpr>(E) || isa<DictionaryExpr>(E) ||
+        isa<StringLiteralExpr>(E) || isa<InterpolatedStringLiteralExpr>(E)) {
+      if (E->getType() && gpuUnsafeType(E->getType(), why))
+        reject(E->getLoc(), "this value", why);
+    }
+    return Action::Continue(E);
+  }
+};
+
+/// Signature + body checks for a `@Compute` kernel.
+static void checkGPUKernel(AbstractFunctionDecl *AFD) {
+  if (!AFD->getAttrs().hasAttribute<ComputeAttr>())
+    return;
+  auto &Diags = AFD->getASTContext().Diags;
+  StringRef noun = "kernel";
+
+  // Effects the GPU can't provide.
+  if (AFD->hasThrows())
+    Diags.diagnose(AFD->getLoc(), diag::gpu_kernel_effect, noun, AFD->getName(),
+                   "throws");
+  if (AFD->hasAsync())
+    Diags.diagnose(AFD->getLoc(), diag::gpu_kernel_effect, noun, AFD->getName(),
+                   "async");
+
+  // A compute kernel returns Void (results go through device buffers).
+  if (auto *fd = dyn_cast<FuncDecl>(AFD)) {
+    Type result = fd->getResultInterfaceType();
+    if (result && !result->hasError() && !result->isVoid())
+      Diags.diagnose(AFD->getLoc(), diag::gpu_kernel_nonvoid, noun,
+                     AFD->getName());
+  }
+
+  if (auto *body = AFD->getBody()) {
+    GPUSafetyWalker walker(Diags, AFD, noun);
+    body->walk(walker);
+  }
+}
