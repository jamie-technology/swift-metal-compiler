+          np = pt + aspace + "*" + attrs + " " + nm;
+          st = pt + aspace + "*";
+        } else {
+          np = params[i];
+          // Extract the leading LLVM type for the signature — it may contain
+          // spaces (`<2 x i32>`, `[4 x float]`), so don't split on the first space.
+          std::smatch tm;
+          if (std::regex_search(
+                  params[i], tm,
+                  std::regex(R"(^(<\d+ x [^>]+>|\[\d+ x [^\]]+\]|[%\w."$]+))")))
+            st = tm[1].str();
+          else
+            st = params[i];
+        }
+        if (i) { newParams += ", "; sig += ", "; }
+        newParams += np;
+        sig += st;
+      }
+      ksig[kname] = "void (" + sig + ")";
+      out += m[1].str() + newParams + m[4].str() + "\n";
+      continue;
+    }
+
+    // Global constant declaration: flatten type + initializer.
+    if (std::regex_match(line, m, reGlobalDecl)) {
+      std::string ft = airFlattenType(m[4].str(), tds);
+      std::string fv = airFlattenConst(m[4].str() + " " + m[5].str(), tds);
+      out += m[1].str() + fv + m[6].str() + "\n";
+      continue;
+    }
+
+    // getelementptr.
+    if (std::regex_match(line, m, reGep)) {
+      std::string indent = m[1].str(), res = m[2].str(), stride = m[3].str();
+      std::string aspace = m[4].str(), base = m[5].str(), idxs = m[6].str();
+      auto git = gtype.find(base);
+      if (git != gtype.end() && !git->second.empty() && git->second[0] == '[') {
+        // Array-global access: rewrite to the 2-index array form.
+        std::string at = git->second;
+        out += indent + res + " = getelementptr inbounds " + at + ", " + at +
+               aspace + "* " + base + ", i64 0" + idxs + "\n";
+      } else {
+        std::string fstride = airFlattenType(stride, tds);
+        out += indent + res + " = getelementptr inbounds " + fstride + ", " +
+               fstride + aspace + "* " + base + idxs + "\n";
+      }
+      continue;
+    }
+
+    // load.
+    if (std::regex_match(line, m, reLoad)) {
+      out += m[1].str() + m[2].str() + " = load " + m[3].str() + ", " +
+             m[3].str() + m[4].str() + "* " + m[5].str() + m[6].str() + "\n";
+      continue;
+    }
+
+    // store.
+    if (std::regex_match(line, m, reStore)) {
+      out += m[1].str() + "store " + m[2].str() + " " + m[3].str() + ", " +
+             m[2].str() + m[4].str() + "* " + m[5].str() + m[6].str() + "\n";
+      continue;
+    }
+
+    // air.kernel metadata: type the function pointer.
+    if (std::regex_match(line, m, reKernelMD) && ksig.count(m[3].str())) {
+      out += m[1].str() + ksig[m[3].str()] + "* " + m[2].str() + m[4].str() +
+             "\n";
+      continue;
+    }
+
+    out += line + "\n";
+  }
+
+  if (!out.empty() && out.back() == '\n')
+    out.pop_back(); // don't add a trailing newline beyond the original
+  return out;
+}
