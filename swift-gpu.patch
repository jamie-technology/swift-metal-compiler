+static void normalizeModuleToAIR(llvm::Module &M) {
+  auto &Ctx = M.getContext();
+
+  // (1) Target facts.
+  M.setTargetTriple(llvm::Triple(kAIRTriple));
+  M.setDataLayout(kAIRDataLayout);
+
+  // (2) Per-function/instruction cleanups for metal-as (LLVM ~17).
+  for (auto &F : M) {
+    if (F.getCallingConv() == llvm::CallingConv::Swift)
+      F.setCallingConv(llvm::CallingConv::C);
+    // AIR intrinsics (declared via @_silgen_name, e.g. air.wg.barrier) must be
+    // `convergent` — the driver requires it and the optimizer must not move a
+    // barrier across divergent control flow. Give the declaration clean
+    // intrinsic attributes instead of the host attributes it inherited.
+    if (F.isDeclaration() && F.getName().starts_with("air.")) {
+      F.setAttributes(llvm::AttributeList());
+      F.addFnAttr(llvm::Attribute::Convergent);
+      F.addFnAttr(llvm::Attribute::NoUnwind);
+      F.addFnAttr(llvm::Attribute::WillReturn);
+    }
+    // Strip parameter attributes metal-as's LLVM (~17) can't parse: the new
+    // `captures(none)` spelling of nocapture.
+    for (unsigned i = 0, e = F.arg_size(); i != e; ++i)
+      F.removeParamAttr(i, llvm::Attribute::Captures);
+    // Strip function attributes metal-as can't parse (the `memory(...)` effect
+    // spelling) or that are host-specific (target-cpu/features don't belong in
+    // AIR).
+    F.removeFnAttr(llvm::Attribute::Memory);
+    for (llvm::StringRef a : {"target-cpu", "target-features",
+                              "stack-protector-buffer-size"})
+      F.removeFnAttr(a);
+    // Stack protection is meaningless on the GPU (no stack canary) and the
+    // driver's back-end crashes on `sspreq`/`ssp`/`sspstrong` — Swift adds it to
+    // any function with an addressable local (e.g. the expected-value slot an
+    // atomic compare-exchange needs).
+    F.removeFnAttr(llvm::Attribute::StackProtect);
+    F.removeFnAttr(llvm::Attribute::StackProtectReq);
+    F.removeFnAttr(llvm::Attribute::StackProtectStrong);
+    for (auto &BB : F) {
+      for (auto &I : llvm::make_early_inc_range(BB)) {
+        // Strip !prof (branch_weights) metadata: metal-as's LLVM (~17) rejects
+        // the newer `!{!"branch_weights", !"expected", ...}` form ("Wrong
+        // number of operands"), and profile weights are meaningless for a
+        // shader. This is what lets integer kernels — whose overflow checks
+        // emit conditional branches — assemble.
+        I.setMetadata(llvm::LLVMContext::MD_prof, nullptr);
+        if (auto *GEP = llvm::dyn_cast<llvm::GetElementPtrInst>(&I))
+          GEP->setNoWrapFlags(llvm::GEPNoWrapFlags::none());
+        if (auto *CB = llvm::dyn_cast<llvm::CallBase>(&I)) {
+          if (CB->getCallingConv() == llvm::CallingConv::Swift)
+            CB->setCallingConv(llvm::CallingConv::C);
+          // Mark calls to AIR intrinsics (e.g. air.wg.barrier) convergent.
+          if (auto *callee = CB->getCalledFunction())
+            if (callee->getName().starts_with("air."))
+              CB->addFnAttr(llvm::Attribute::Convergent);
+        }
+        // Strip newer LLVM flags metal-as (~17) can't parse: `nneg` on zext,
+        // `disjoint` on or (mirrors the `nuw`-off-GEP handling above).
+        if (auto *pnni = llvm::dyn_cast<llvm::PossiblyNonNegInst>(&I))
+          pnni->setNonNeg(false);
+        if (auto *pdi = llvm::dyn_cast<llvm::PossiblyDisjointInst>(&I))
+          pdi->setIsDisjoint(false);
+        // Materialize non-zero splat constants as shufflevector (metal-as's LLVM
+        // has no `splat (T V)` constant syntax).
+        for (unsigned oi = 0, oe = I.getNumOperands(); oi != oe; ++oi) {
+          auto *C = llvm::dyn_cast<llvm::Constant>(I.getOperand(oi));
+          if (!C || llvm::isa<llvm::ConstantAggregateZero>(C)) continue;
+          auto *VT = llvm::dyn_cast<llvm::FixedVectorType>(C->getType());
+          if (!VT) continue;
+          llvm::Constant *splat = C->getSplatValue();
+          if (!splat) continue;
+          // NoFolder: otherwise the builder folds the shuffle straight back into
+          // the splat constant we're trying to eliminate.
+          llvm::IRBuilder<llvm::NoFolder> B(&I);
+          llvm::Value *ins = B.CreateInsertElement(llvm::PoisonValue::get(VT),
+                                                   splat, B.getInt64(0));
+          auto *maskTy = llvm::FixedVectorType::get(B.getInt32Ty(),
+                                                    VT->getNumElements());
+          llvm::Value *shuf = B.CreateShuffleVector(
+              ins, llvm::PoisonValue::get(VT),
+              llvm::Constant::getNullValue(maskTy));
+          I.setOperand(oi, shuf);
+        }
+      }
+    }
+  }
+
+  // (2c) Fix uint3 builtins. Swift's SIMD3<UInt32> lowers to `<4 x i32>` (padded),
+  // but the driver's `thread_position_in_grid` (and 3-D texture coords) need
+  // `<3 x i32>`. Rebuild each kernel whose signature has a `<4 x i32>` value param
+  // (only a uint3 builtin can be one — buffers/textures are pointers, positions
+  // are at most 3-D), changing that param to `<3 x i32>` and shuffling it back to
+  // `<4 x i32>` at entry so the body is unchanged.
+  if (auto *swiftgpu = M.getNamedMetadata("swiftgpu.kernels")) {
+    auto *i32Ty = llvm::Type::getInt32Ty(Ctx);
+    auto *v3i32 = llvm::FixedVectorType::get(i32Ty, 3);
+    auto *v4i32 = llvm::FixedVectorType::get(i32Ty, 4);
+    for (auto *kn : swiftgpu->operands()) {
+      if (kn->getNumOperands() < 1) continue;
+      auto *fnMD = llvm::dyn_cast<llvm::ValueAsMetadata>(kn->getOperand(0));
+      if (!fnMD) continue;
+      auto *F = llvm::dyn_cast_or_null<llvm::Function>(fnMD->getValue());
+      if (!F || F->isDeclaration()) continue;
+
+      bool hasUint3 = false;
+      llvm::SmallVector<llvm::Type *, 8> params;
+      for (auto &a : F->args()) {
+        if (a.getType() == v4i32) { hasUint3 = true; params.push_back(v3i32); }
+        else params.push_back(a.getType());
+      }
+      if (!hasUint3) continue;
+
+      auto *newFT = llvm::FunctionType::get(F->getReturnType(), params,
+                                            F->isVarArg());
+      auto *NF = llvm::Function::Create(newFT, F->getLinkage(),
+                                        F->getAddressSpace(), "", &M);
+      NF->copyAttributesFrom(F);
+      NF->setCallingConv(F->getCallingConv());
+      NF->splice(NF->begin(), F);
+      llvm::IRBuilder<> B(&*NF->getEntryBlock().getFirstInsertionPt());
+      for (unsigned i = 0, e = F->arg_size(); i != e; ++i) {
+        llvm::Argument *oldA = F->getArg(i), *newA = NF->getArg(i);
+        newA->takeName(oldA);
+        if (oldA->getType() == v4i32) {
+          llvm::Value *sh = B.CreateShuffleVector(
+              newA, llvm::PoisonValue::get(v3i32),
+              llvm::ArrayRef<int>{0, 1, 2, -1});
+          oldA->replaceAllUsesWith(sh);
+        } else {
+          oldA->replaceAllUsesWith(newA);
+        }
+      }
+      // A function is an opaque `ptr` value, so F and NF have the same value
+      // type — RAUW updates the remaining references (llvm.used, metadata).
+      std::string name = F->getName().str();
+      F->replaceAllUsesWith(NF);
+      F->eraseFromParent();
+      NF->setName(name);
+    }
+  }
+
+  // (3) Convert !swiftgpu.kernels into the AIR entry-point + argument metadata.
+  if (auto *swiftgpu = M.getNamedMetadata("swiftgpu.kernels")) {
+    llvm::SmallVector<llvm::Metadata *, 4> airKernels;
+    for (auto *kn : swiftgpu->operands()) {
+      if (kn->getNumOperands() < 3) continue;
+      auto *fnMD = llvm::dyn_cast<llvm::ValueAsMetadata>(kn->getOperand(0));
+      auto *argsMD = llvm::dyn_cast<llvm::MDNode>(kn->getOperand(2));
+      if (!fnMD || !argsMD) continue;
+
+      llvm::SmallVector<llvm::Metadata *, 8> airArgs;
+      // Threadgroup (addrspace 3) buffers are bound in their own 0-based index
+      // namespace ([[threadgroup(N)]]), separate from device/constant buffers
+      // ([[buffer(N)]]) — matching MSL. The driver rejects a threadgroup arg
+      // whose location index doesn't start there.
+      int threadgroupIndex = 0;
+      int textureIndex = 0;
+      int samplerIndex = 0;
+      for (auto &argOp : argsMD->operands()) {
+        auto *a = llvm::dyn_cast<llvm::MDNode>(argOp.get());
+        if (!a || a->getNumOperands() < 5) continue;
+        int pos = mdInt(a->getOperand(0));
+        llvm::StringRef role = mdStr(a->getOperand(1));
+        int slot = mdInt(a->getOperand(2));
+        llvm::StringRef type = mdStr(a->getOperand(3));
+        llvm::StringRef name = mdStr(a->getOperand(4));
+
+        if (role == "buffer") {
+          bool isMutable = false; unsigned as = 1; std::string pointee;
+          parsePointerType(type, isMutable, as, pointee);
+          auto [airName, size, align] = airTypeForPointee(pointee);
+          int index = as == 3 ? threadgroupIndex++ : (slot >= 0 ? slot : pos);
+          airArgs.push_back(llvm::MDNode::get(Ctx, {
+            mdi(Ctx, pos), mds(Ctx, "air.buffer"),
+            mds(Ctx, "air.location_index"), mdi(Ctx, index), mdi(Ctx, 1),
+            mds(Ctx, isMutable ? "air.read_write" : "air.read"),
+            mds(Ctx, "air.address_space"), mdi(Ctx, (int)as),
+            mds(Ctx, "air.arg_type_size"), mdi(Ctx, (int)size),
+            mds(Ctx, "air.arg_type_align_size"), mdi(Ctx, (int)align),
+            mds(Ctx, "air.arg_type_name"), mds(Ctx, airName),
+            mds(Ctx, "air.arg_name"), mds(Ctx, name)}));
+        } else if (role == "texture") {
+          // Textures are bound in their own 0-based [[texture(N)]] namespace.
+          // Recover dimension + access + element type from the Swift type name
+          // (`type`), e.g. "WriteTexture3D<Float16>" -> texture3d, write, half.
+          bool is3D = type.contains("3D");
+          llvm::StringRef access = type.starts_with("ReadWrite") ? "air.read_write"
+                                 : type.starts_with("Write")     ? "air.write"
+                                                                 : "air.read";
+          llvm::StringRef accessWord = access == "air.read_write" ? "read_write"
+                                     : access == "air.write"      ? "write"
+                                                                  : "read";
+          // Element type from the generic argument.
+          llvm::StringRef elem = "float";
+          if (type.contains("<Float16>")) elem = "half";
+          else if (type.contains("<UInt32>")) elem = "uint";
+          else if (type.contains("<Int32>")) elem = "int";
+          std::string typeName = (std::string(is3D ? "texture3d" : "texture2d") +
+                                  "<" + elem.str() + ", " + accessWord.str() + ">");
+          // The binding slot within the [[texture(N)]] namespace comes from an
+          // explicit @Binding(to:) if present, else the appearance order. (The
+          // resource *kind* is the type's job — there is no @Texture attribute.)
+          int index = slot >= 0 ? slot : textureIndex;
+          textureIndex = index + 1;
+          airArgs.push_back(llvm::MDNode::get(Ctx, {
+            mdi(Ctx, pos), mds(Ctx, "air.texture"),
+            mds(Ctx, "air.location_index"), mdi(Ctx, index), mdi(Ctx, 1),
+            mds(Ctx, access),
+            mds(Ctx, "air.arg_type_name"), mds(Ctx, typeName),
+            mds(Ctx, "air.arg_name"), mds(Ctx, name)}));
+        } else if (role == "sampler") {
+          // Samplers have their own 0-based [[sampler(N)]] namespace; @Binding(to:)
+          // sets the slot explicitly, else appearance order.
+          int index = slot >= 0 ? slot : samplerIndex;
+          samplerIndex = index + 1;
+          airArgs.push_back(llvm::MDNode::get(Ctx, {
+            mdi(Ctx, pos), mds(Ctx, "air.sampler"),
+            mds(Ctx, "air.location_index"), mdi(Ctx, index), mdi(Ctx, 1),
+            mds(Ctx, "air.arg_type_name"), mds(Ctx, "sampler"),
+            mds(Ctx, "air.arg_name"), mds(Ctx, name)}));
+        } else {
+          airArgs.push_back(llvm::MDNode::get(Ctx, {
+            mdi(Ctx, pos), mds(Ctx, builtinAirName(role)),
+            mds(Ctx, "air.arg_type_name"), mds(Ctx, airBuiltinTypeName(type)),
+            mds(Ctx, "air.arg_name"), mds(Ctx, name)}));
+        }
+      }
+
+      airKernels.push_back(llvm::MDNode::get(Ctx, {
+        fnMD, llvm::MDNode::get(Ctx, {}), llvm::MDNode::get(Ctx, airArgs)}));
+    }
+    swiftgpu->eraseFromParent();
+    if (!airKernels.empty()) {
+      auto *airKernel = M.getOrInsertNamedMetadata("air.kernel");
+      for (auto *k : airKernels)
+        airKernel->addOperand(llvm::cast<llvm::MDNode>(k));
+    }
+  }
+
+  // (3b) Strip the "PIC Level" module flag. Position-independent code is
+  // meaningless for a GPU shader (a metallib is not relocated like a host
+  // dylib), and — critically — it makes the driver's back-end compiler crash on
+  // a program-scope constant global in the constant address space (addrspace 2,
+  // e.g. `let table: InlineArray<N,Float> = [...]`). Device-only kernels
+  // tolerate it because they have no global data to relocate.
+  if (auto *ModFlags = M.getNamedMetadata("llvm.module.flags")) {
+    llvm::SmallVector<llvm::MDNode *, 16> keep;
+    for (llvm::MDNode *op : ModFlags->operands()) {
+      if (op->getNumOperands() >= 2)
+        if (auto *key = llvm::dyn_cast<llvm::MDString>(op->getOperand(1)))
+          if (key->getString() == "PIC Level")
+            continue;
+      keep.push_back(op);
+    }
+    ModFlags->clearOperands();
+    for (auto *op : keep)
+      ModFlags->addOperand(op);
+  }
+
+  // (3c) Strip Swift runtime metadata — nominal type descriptors / metadata
+  // records / reflection for user types (e.g. Texture2D) land in `__swift5_*` /
+  // `__constg_swiftt` sections that metal-as can't parse (odd sections,
+  // `no_sanitize_address`). A GPU module has no Swift runtime, so they're dead
+  // weight. They're referenced only by `llvm.used`/`llvm.compiler.used` and each
+  // other; drop those anchors, then erase the records (and their now-unused
+  // metadata-accessor functions).
+  for (const char *n : {"llvm.used", "llvm.compiler.used"})
+    if (auto *gv = M.getNamedGlobal(n))
+      gv->eraseFromParent();
+  {
+    // Swift-mangled symbols ($s…) are type descriptors, metadata records, value
+    // witnesses and accessors for our types — a GPU module needs none of them
+    // (kernels are named via @_silgen_name, intrinsics are `air.*`, so no live
+    // code references them). They form a mutually-referential cluster (witness
+    // functions call each other; descriptors reference accessors), so no member
+    // is ever individually unused — RAUW the whole set to undef first to break
+    // the cycle, then erase.
+    auto isSwiftRuntimeSymbol = [](llvm::StringRef n) {
+      return n.starts_with("$s") || n.starts_with("__swift") ||
+             n.starts_with("swift_") || n.starts_with(".str.");
+    };
+    llvm::SmallVector<llvm::GlobalValue *, 32> dead;
+    for (auto &F : M)
+      if (isSwiftRuntimeSymbol(F.getName()))
+        dead.push_back(&F);
+    for (auto &GV : M.globals())
+      // Metadata globals are in the default address space (addrspace 0); a GPU
+      // *data* global (e.g. a constant `let` table in addrspace 2) also carries a
+      // `$s` mangled name but must be kept.
+      if (isSwiftRuntimeSymbol(GV.getName()) && GV.getAddressSpace() == 0)
+        dead.push_back(&GV);
+    // Aliases too (e.g. a type-metadata alias `$s…VN = alias …`) — otherwise one
+    // is left pointing at `undef` and metal-as rejects the module.
+    for (auto &GA : M.aliases())
+      if (isSwiftRuntimeSymbol(GA.getName()))
+        dead.push_back(&GA);
+    for (auto *gv : dead)
+      gv->replaceAllUsesWith(llvm::UndefValue::get(gv->getType()));
+    for (auto *gv : dead)
+      gv->eraseFromParent();
+  }
+
+  // (4) Module-level AIR facts.
+  auto flag = [&](const char *n, int v) {
+    M.addModuleFlag(llvm::Module::Max, n, (uint32_t)v);
+  };
+  flag("air.max_device_buffers", 31);
+  flag("air.max_constant_buffers", 31);
+  flag("air.max_threadgroup_buffers", 31);
+  flag("air.max_textures", 128);
+  flag("air.max_read_write_textures", 8);
+  flag("air.max_samplers", 16);
+  auto *airVersion = M.getOrInsertNamedMetadata("air.version");
+  if (airVersion->getNumOperands() == 0)
+    airVersion->addOperand(llvm::MDNode::get(
+        Ctx, {mdi(Ctx, 2), mdi(Ctx, 8), mdi(Ctx, 0)}));
+  auto *airLang = M.getOrInsertNamedMetadata("air.language_version");
+  if (airLang->getNumOperands() == 0)
+    airLang->addOperand(llvm::MDNode::get(
+        Ctx, {mds(Ctx, "Metal"), mdi(Ctx, 3), mdi(Ctx, 2), mdi(Ctx, 0)}));
+}
