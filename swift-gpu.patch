+/// AddressSpaceType - a pointer type qualified with a GPU address space
+/// (swift-metal). Wraps a pointer object type (e.g. UnsafePointer<Float>) and
+/// tags it with an LLVM address space (device=1, constant=2, threadgroup=3,
+/// thread=0), making it a distinct type so IRGen lowers it to `ptr addrspace(N)`.
+class AddressSpaceType : public TypeBase {
+  Type ObjectTy;
+  unsigned TheAddressSpace;
+
+  AddressSpaceType(Type objectTy, unsigned addressSpace,
+                   const ASTContext *canonicalContext,
+                   RecursiveTypeProperties properties)
+    : TypeBase(TypeKind::AddressSpace, canonicalContext, properties),
+      ObjectTy(objectTy), TheAddressSpace(addressSpace) {}
+
+public:
+  static AddressSpaceType *get(Type type, unsigned addressSpace);
+
+  Type getObjectType() const { return ObjectTy; }
+  unsigned getAddressSpace() const { return TheAddressSpace; }
+
+  static bool classof(const TypeBase *type) {
+    return type->getKind() == TypeKind::AddressSpace;
+  }
+};
+BEGIN_CAN_TYPE_WRAPPER(AddressSpaceType, Type)
+  PROXY_CAN_TYPE_SIMPLE_GETTER(getObjectType)
+  static CanAddressSpaceType get(CanType type, unsigned addressSpace) {
+    return CanAddressSpaceType(AddressSpaceType::get(type, addressSpace));
+  }
+END_CAN_TYPE_WRAPPER(AddressSpaceType, Type)
+
 
