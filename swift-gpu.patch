+/// swift-metal: if `D` carries a GPU address-space attribute
+/// (@Device/@Constant/@Threadgroup/@Thread) and `ty` is a pointer type, wrap it
+/// in an AddressSpaceType so IRGen lowers it to `ptr addrspace(N)`.
+static Type applyGPUAddressSpace(const ValueDecl *D, Type ty) {
+  if (!ty || ty->hasError())
+    return ty;
+
+  const DeclAttributes &attrs = D->getAttrs();
+  unsigned space;
+  if (attrs.hasAttribute<DeviceAttr>()) space = 1;
+  else if (attrs.hasAttribute<ConstantAttr>()) space = 2;
+  else if (attrs.hasAttribute<ThreadgroupAttr>()) space = 3;
+  else if (attrs.hasAttribute<ThreadAttr>()) space = 0;
+  else return ty;
+
+  // Clang/MSL model: the address space qualifies the POINTEE, not the pointer.
+  // `@Device _ p: UnsafePointer<Float>` becomes `UnsafePointer<device Float>`,
+  // so `p` stays an ordinary UnsafePointer<X> (no coercion wall); IRGen lowers a
+  // pointer to address-space-N memory to `ptr addrspace(N)`.
+  if (auto *bgt = ty->getAs<BoundGenericStructType>()) {
+    StringRef n = bgt->getDecl()->getName().str();
+    if ((n == "UnsafePointer" || n == "UnsafeMutablePointer") &&
+        bgt->getGenericArgs().size() == 1) {
+      Type pointee = bgt->getGenericArgs()[0];
+      Type qualified = AddressSpaceType::get(pointee, space);
+      return BoundGenericType::get(bgt->getDecl(), bgt->getParent(),
+                                   {qualified});
+    }
+  }
+
+  // A bare Builtin.RawPointer has no pointee; qualify it directly.
+  if (ty->is<BuiltinRawPointerType>())
+    return AddressSpaceType::get(ty, space);
+
+  return ty;
+}
