+struct SwiftGPUAIRNormalizePass
+    : llvm::PassInfoMixin<SwiftGPUAIRNormalizePass> {
+  llvm::PreservedAnalyses run(llvm::Module &M, llvm::ModuleAnalysisManager &) {
+    normalizeModuleToAIR(M);
+    return llvm::PreservedAnalyses::none();
+  }
+};
