+class BindingAttr : public DeclAttribute {
+public:
+  BindingAttr(unsigned Index, SourceLoc AtLoc, SourceRange Range, bool Implicit)
+      : DeclAttribute(DeclAttrKind::Binding, AtLoc, Range, Implicit) {
+    Bits.BindingAttr.Index = Index;
+  }
+
+  unsigned getIndex() const { return Bits.BindingAttr.Index; }
+
+  static bool classof(const DeclAttribute *DA) {
+    return DA->getKind() == DeclAttrKind::Binding;
+  }
+
+  BindingAttr *clone(ASTContext &ctx) const {
+    return new (ctx) BindingAttr(getIndex(), AtLoc, Range, isImplicit());
+  }
+
+  bool isEquivalent(const BindingAttr *other, Decl *attachedTo) const {
+    return getIndex() == other->getIndex();
