+  std::string cur;
+  for (char c : s) {
+    if (c == '<' || c == '[' || c == '{' || c == '(')
+      ++depth;
+    else if (c == '>' || c == ']' || c == '}' || c == ')')
+      --depth;
+    if (c == ',' && depth == 0) {
+      out.push_back(airTrim(cur));
+      cur.clear();
+    } else {
+      cur += c;
+    }
