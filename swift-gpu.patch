+/// swift-metal: describe each @Compute kernel's binding contract in a
+/// !swiftgpu.kernels named-metadata node, so an out-of-tree backend can lower
+/// it to AIR without re-parsing the Swift source. One node per kernel:
+///   !{ ptr @sym, !"compute", !args }
+/// with one argument node each: !{ i32 astIdx, !"role", i32 slot, !"type", !"name" }
+/// where role is "buffer" or a thread/grid builtin marker, and slot is the
+/// @Binding index (or -1).
+void IRGenModule::emitSwiftGPUKernelMetadata() {
+  if (this != IRGen.getPrimaryIGM())
+    return;
+
+  auto &ctx = Module.getContext();
+  auto *i32Ty = llvm::Type::getInt32Ty(ctx);
+  auto mdStr = [&](llvm::StringRef s) -> llvm::Metadata * {
+    return llvm::MDString::get(ctx, s);
+  };
+  auto mdInt = [&](int v) -> llvm::Metadata * {
+    return llvm::ConstantAsMetadata::get(llvm::ConstantInt::getSigned(i32Ty, v));
+  };
+
+  llvm::SmallVector<llvm::Metadata *, 4> kernels;
+
+  for (SILFunction &f : getSILModule()) {
+    FuncDecl *fd = nullptr;
+    if (f.hasLocation())
+      fd = dyn_cast_or_null<FuncDecl>(f.getLocation().getAsASTNode<ValueDecl>());
+    if (!fd)
+      if (auto *dc = f.getDeclContext())
+        fd = dyn_cast_or_null<FuncDecl>(dc);
+    if (!fd || !fd->getAttrs().hasAttribute<ComputeAttr>())
+      continue;
+
+    llvm::Function *llvmFn = getAddrOfSILFunction(&f, NotForDefinition);
+    if (!llvmFn)
+      continue;
+
+    llvm::SmallVector<llvm::Metadata *, 8> args;
+    auto *params = fd->getParameters();
+    for (unsigned i = 0, n = params->size(); i != n; ++i) {
+      ParamDecl *p = params->get(i);
+
+      const char *role = "buffer";
+      int slot = -1;
+      if (auto *b = p->getAttrs().getAttribute<BindingAttr>())
+        slot = (int)b->getIndex();
+      if (p->getAttrs().hasAttribute<ThreadPositionInGridAttr>())
+        role = "threadPositionInGrid";
+      else if (p->getAttrs().hasAttribute<ThreadPositionInThreadgroupAttr>())
+        role = "threadPositionInThreadgroup";
+      else if (p->getAttrs().hasAttribute<ThreadgroupPositionInGridAttr>())
+        role = "threadgroupPositionInGrid";
+      else if (p->getAttrs().hasAttribute<ThreadIndexInThreadgroupAttr>())
+        role = "threadIndexInThreadgroup";
+      else if (p->getAttrs().hasAttribute<ThreadsPerThreadgroupAttr>())
+        role = "threadsPerThreadgroup";
+      else if (p->getAttrs().hasAttribute<ThreadgroupsPerGridAttr>())
+        role = "threadgroupsPerGrid";
+
+      // swift-metal: a texture handle (Texture2D/Texture3D/Write*/ReadWrite*
+      // from the textures package) becomes an air.texture argument, not an
+      // air.buffer. The dimension + access are recovered from the type name (the
+      // recorded typeStr) by the normalize pass.
+      if (auto *nom = p->getInterfaceType()->getAnyNominal()) {
+        StringRef tn = nom->getName().str();
+        if (tn == "Texture2D" || tn == "WriteTexture2D" ||
+            tn == "ReadWriteTexture2D" || tn == "Texture3D" ||
+            tn == "WriteTexture3D")
+          role = "texture";
+        else if (tn == "Sampler")
+          role = "sampler";
+      }
+
+      std::string typeStr = p->getInterfaceType().getString();
+      std::string nameStr = p->getName().str().str();
+
+      args.push_back(llvm::MDTuple::get(
+          ctx, {mdInt((int)i), mdStr(role), mdInt(slot), mdStr(typeStr),
+                mdStr(nameStr)}));
+    }
+
+    kernels.push_back(llvm::MDTuple::get(
+        ctx, {llvm::ValueAsMetadata::get(llvmFn), mdStr("compute"),
+              llvm::MDTuple::get(ctx, args)}));
+  }
+
+  if (kernels.empty())
+    return;
+
+  auto *nmd = Module.getOrInsertNamedMetadata("swiftgpu.kernels");
+  for (auto *k : kernels)
+    nmd->addOperand(llvm::cast<llvm::MDNode>(k));
+}
