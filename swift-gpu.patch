+AddressSpaceType *AddressSpaceType::get(Type objectTy, unsigned addressSpace) {
+  auto properties = objectTy->getRecursiveProperties();
+  auto arena = getArena(properties);
+  auto &C = objectTy->getASTContext();
+  auto &entry = C.getImpl().getArena(arena)
+                    .AddressSpaceTypes[{objectTy, addressSpace}];
+  if (entry)
+    return entry;
+  const ASTContext *canonicalContext = objectTy->isCanonical() ? &C : nullptr;
+  return entry = new (C, arena) AddressSpaceType(objectTy, addressSpace,
+                                                 canonicalContext, properties);
+}
