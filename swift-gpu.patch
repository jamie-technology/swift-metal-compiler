+// swift-metal: normalize an optimized module into loadable Apple AIR.
+// Address spaces are already native (IRGen emits ptr addrspace(N)); this handles
+// the remaining gaps to metal-as (an ~LLVM 17 assembler) and the ABI metadata.
+namespace {
+
+static const char *kAIRTriple = "air64_v28-apple-macosx26.0.0";
+static const char *kAIRDataLayout =
+    "e-p:64:64:64-i1:8:8-i8:8:8-i16:16:16-i32:32:32-i64:64:64-f32:32:32-"
+    "f64:64:64-v16:16:16-v24:32:32-v32:32:32-v48:64:64-v64:64:64-v96:128:128-"
+    "v128:128:128-v192:256:256-v256:256:256-v512:512:512-v1024:1024:1024-n8:16:32";
+
+/// Map a Swift pointee spelling to its AIR type name + size/align.
+static std::tuple<std::string, unsigned, unsigned>
+airTypeForPointee(llvm::StringRef p) {
+  p = p.trim();
+  if (p == "Float" || p == "Float32") return {"float", 4, 4};
+  if (p == "SIMD2<Float>") return {"float2", 8, 8};
+  if (p == "SIMD3<Float>") return {"float3", 16, 16};
+  if (p == "SIMD4<Float>") return {"float4", 16, 16};
+  if (p == "UInt32") return {"uint", 4, 4};
+  if (p == "Int32") return {"int", 4, 4};
+  if (p == "Float16") return {"half", 2, 2};
+  return {"float", 4, 4};
+}
+
+/// Parse a pointer type string: mutability, address space, pointee spelling.
+static bool parsePointerType(llvm::StringRef t, bool &isMutable,
+                             unsigned &addressSpace, std::string &pointee) {
+  t = t.trim();
+  if (t.consume_front("UnsafeMutablePointer<")) isMutable = true;
+  else if (t.consume_front("UnsafePointer<")) isMutable = false;
+  else return false;
+  if (!t.consume_back(">")) return false;
+  t = t.trim();
+  addressSpace = 0;
+  if (t.consume_front("device ")) addressSpace = 1;
+  else if (t.consume_front("constant ")) addressSpace = 2;
+  else if (t.consume_front("threadgroup ")) addressSpace = 3;
+  else if (t.consume_front("thread ")) addressSpace = 0;
+  pointee = t.trim().str();
+  return true;
+}
+
+/// AIR scalar/vector type name for a thread/grid builtin whose Swift type is
+/// `swiftType` (e.g. `UInt32` -> "uint", `SIMD2<UInt32>` -> "uint2" for 2D
+/// dispatch). Positions are unsigned; the SIMD2 case is ABI-clean (`<2 x i32>`
+/// matches MSL `uint2`).
+static llvm::StringRef airBuiltinTypeName(llvm::StringRef swiftType) {
+  swiftType = swiftType.trim();
+  if (swiftType == "SIMD2<UInt32>") return "uint2";
+  if (swiftType == "SIMD3<UInt32>") return "uint3";
+  if (swiftType == "SIMD4<UInt32>") return "uint4";
+  if (swiftType == "SIMD2<Int32>") return "int2";
+  if (swiftType == "SIMD3<Int32>") return "int3";
+  if (swiftType == "SIMD4<Int32>") return "int4";
+  if (swiftType == "Int32") return "int";
+  return "uint"; // UInt32 and default
+}
+
+/// snake_case AIR name for a thread/grid builtin marker (threadPositionInGrid ->
+/// air.thread_position_in_grid).
+static std::string builtinAirName(llvm::StringRef marker) {
+  std::string out = "air.";
+  for (char c : marker) {
+    if (isupper(c)) { out += '_'; out += tolower(c); }
+    else out += c;
+  }
+  return out;
+}
+
+static llvm::MDString *mds(llvm::LLVMContext &c, llvm::StringRef s) {
+  return llvm::MDString::get(c, s);
+}
+static llvm::Metadata *mdi(llvm::LLVMContext &c, int v) {
+  return llvm::ConstantAsMetadata::get(
+      llvm::ConstantInt::getSigned(llvm::Type::getInt32Ty(c), v));
+}
+static llvm::StringRef mdStr(const llvm::MDOperand &op) {
+  if (auto *s = llvm::dyn_cast<llvm::MDString>(op.get())) return s->getString();
+  return {};
+}
+static int mdInt(const llvm::MDOperand &op) {
+  if (auto *c = llvm::dyn_cast<llvm::ConstantAsMetadata>(op.get()))
+    if (auto *ci = llvm::dyn_cast<llvm::ConstantInt>(c->getValue()))
+      return (int)ci->getSExtValue();
+  return -1;
+}
