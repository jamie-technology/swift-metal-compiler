+///
+/// swift-metal: reject GPU-unsafe constructs anywhere in the call graph
+/// reachable from a `@Compute` kernel.
+///
+/// The AST-level checker (`checkGPUKernel` in Sema) handles the kernel's own
+/// signature and body literals. This is the complementary, airtight half: it
+/// follows the kernel's transitive calls into *user helper functions* and flags,
+/// structurally in SIL, things that need the (absent) GPU runtime:
+///   - heap allocation (`alloc_ref`, `alloc_box`, `alloc_existential_box`)
+///   - recursion (a cycle in the call graph — the GPU has no call stack)
+///
+/// It scans only functions defined in the module being compiled (user code),
+/// not serialized stdlib functions, and runs on the canonical SILModule (after
+/// mandatory inlining), so it sees the real, de-wrapped call graph without
+/// false-flagging stdlib internals. It is a no-op unless the module contains a
+/// kernel. It runs as a direct call from `runSILDiagnosticPasses` rather than a
+/// pass-manager pass (the fork's pass manager is Swift-only for new passes).
+///
+//===----------------------------------------------------------------------===//
+
+#define DEBUG_TYPE "diagnose-gpu-unsafe"
+#include "swift/AST/Attr.h"
+#include "swift/AST/DiagnosticEngine.h"
+#include "swift/AST/DiagnosticsSema.h"
+#include "swift/Demangling/Demangle.h"
+#include "swift/SIL/ApplySite.h"
+#include "swift/SIL/SILFunction.h"
+#include "swift/SIL/SILInstruction.h"
+#include "swift/SIL/SILModule.h"
+#include "swift/SILOptimizer/PassManager/Passes.h"
+#include "llvm/ADT/SmallPtrSet.h"
+#include "llvm/ADT/SmallVector.h"
+#include <functional>
+
+using namespace swift;
+
+namespace {
+
+/// Is `fn` user code from the module being compiled (as opposed to a serialized
+/// import like the standard library, or an intrinsic declaration)?
+static bool isUserCode(SILFunction *fn) {
+  return fn && !fn->empty() && !fn->isSerialized() &&
+         !fn->isExternalDeclaration();
+}
+
+/// True if `fn` is a GPU compute kernel (its decl carries `@Compute`).
+static bool isComputeKernel(SILFunction *fn) {
+  if (auto *decl = fn->getLocation().getAsASTNode<ValueDecl>())
+    return decl->getAttrs().hasAttribute<ComputeAttr>();
+  return false;
+}
+
+class GPUUnsafeChecker {
+  DiagnosticEngine &Diags;
+
+  /// Flag the unsafe allocation instructions in `fn`. `kernel` is the entry
+  /// kernel it was reached from (for the note); null if `fn` *is* the kernel.
+  void scanFunction(SILFunction *fn, SILFunction *kernel) {
+    for (auto &bb : *fn) {
+      for (auto &inst : bb) {
+        StringRef what;
+        if (isa<AllocRefInst>(inst) || isa<AllocRefDynamicInst>(inst))
+          what = "a class instance (needs ARC / the heap)";
+        else if (isa<AllocBoxInst>(inst))
+          what = "a heap-allocated box (an escaping capture)";
+        else if (isa<AllocExistentialBoxInst>(inst))
+          what = "a boxed existential";
+        if (what.empty())
+          continue;
+        Diags.diagnose(inst.getLoc().getSourceLoc(), diag::gpu_unsafe_sil, what);
+        if (kernel)
+          Diags.diagnose(fn->getLocation().getSourceLoc(),
+                         diag::gpu_reached_from_kernel, kernel->getName(), "");
+      }
+    }
+  }
+
+public:
+  GPUUnsafeChecker(DiagnosticEngine &diags) : Diags(diags) {}
+
+  /// DFS the call graph from `kernel`, scanning each reachable user function
+  /// once and reporting call-graph cycles as recursion.
+  void walkKernel(SILFunction *kernel) {
+    llvm::SmallPtrSet<SILFunction *, 16> visited;
+    llvm::SmallPtrSet<SILFunction *, 16> onPath;
+    bool reportedRecursion = false;
+
+    std::function<void(SILFunction *, bool)> dfs = [&](SILFunction *fn,
+                                                       bool isEntry) {
+      if (!onPath.insert(fn).second) {
+        // Back-edge: `fn` is already on the current DFS path → recursion.
+        if (!reportedRecursion) {
+          Diags.diagnose(fn->getLocation().getSourceLoc(), diag::gpu_recursion);
+          if (fn != kernel)
+            Diags.diagnose(kernel->getLocation().getSourceLoc(),
+                           diag::gpu_reached_from_kernel, kernel->getName(), "");
+          reportedRecursion = true;
+        }
+        return;
+      }
+      if (visited.insert(fn).second)
+        scanFunction(fn, isEntry ? nullptr : kernel);
+
+      for (auto &bb : *fn)
+        for (auto &inst : bb)
+          if (auto apply = FullApplySite::isa(&inst)) {
+            SILFunction *callee = apply.getReferencedFunctionOrNull();
+            if (isUserCode(callee))
+              dfs(callee, /*isEntry=*/false);
+          }
+      onPath.erase(fn);
+    };
+
+    dfs(kernel, /*isEntry=*/true);
+  }
+};
+
+} // end anonymous namespace
+
+/// Collect the `@Compute` kernels defined in `M`.
+static void collectKernels(SILModule &M,
+                           llvm::SmallVectorImpl<SILFunction *> &kernels) {
+  for (auto &fn : M)
+    if (isUserCode(&fn) && isComputeKernel(&fn))
+      kernels.push_back(&fn);
+}
+
+void swift::diagnoseGPUUnsafeConstructs(SILModule &M) {
+  llvm::SmallVector<SILFunction *, 4> kernels;
+  collectKernels(M, kernels);
+  if (kernels.empty())
+    return;
+
+  GPUUnsafeChecker checker(M.getASTContext().Diags);
+  for (auto *kernel : kernels)
+    checker.walkKernel(kernel);
+}
+
+namespace {
+
+/// The airtight post-optimization backstop. After full `-O` (inlining,
+/// specialization, dead-code elimination), only code the kernel actually reaches
+/// remains — so it is now safe to recurse into stdlib functions too, and flag:
+///   - any surviving heap allocation (`alloc_ref`/`alloc_box`/…), and
+///   - a call to an *external* function that has no GPU implementation and is not
+///     an `air.*` intrinsic — an unresolvable runtime/standard-library
+///     dependency (e.g. a random-number source or an allocator that would emit a
+///     call to an undefined symbol on the GPU).
+///
+/// This closes the gap the pre-`-O` check leaves: an unsafe construct entirely
+/// inside a non-inlined *serialized stdlib* function. It only runs when the
+/// pre-`-O` check found nothing (that check bails the pipeline before
+/// optimization), so there is no double reporting.
+class GPUPostOptChecker {
+  DiagnosticEngine &Diags;
+  llvm::SmallPtrSet<SILFunction *, 32> visited;
+  llvm::SmallPtrSet<const void *, 32> reportedLocs;
+
+  bool alreadyReported(SILLocation loc) {
+    return !reportedLocs.insert(loc.getSourceLoc().getOpaquePointerValue())
+                .second;
+  }
+
+  void visit(SILFunction *fn, SILFunction *kernel, bool isEntry) {
+    if (!visited.insert(fn).second)
+      return;
+    for (auto &bb : *fn) {
+      for (auto &inst : bb) {
+        // Surviving heap allocation.
+        if (isa<AllocRefInst>(inst) || isa<AllocRefDynamicInst>(inst) ||
+            isa<AllocBoxInst>(inst) || isa<AllocExistentialBoxInst>(inst)) {
+          if (!alreadyReported(inst.getLoc())) {
+            Diags.diagnose(inst.getLoc().getSourceLoc(), diag::gpu_unsafe_sil,
+                           "a heap allocation");
+            if (!isEntry)
+              Diags.diagnose(kernel->getLocation().getSourceLoc(),
+                             diag::gpu_reached_from_kernel, kernel->getName(),
+                             "");
+          }
+        }
+        // Call into the reachable graph.
+        auto apply = FullApplySite::isa(&inst);
+        if (!apply)
+          continue;
+        SILFunction *callee = apply.getReferencedFunctionOrNull();
+        if (!callee)
+          continue; // indirect (devirtualization already ran); leave to codegen
+        if (!callee->empty() && !callee->isExternalDeclaration()) {
+          visit(callee, kernel, /*isEntry=*/false);
+          continue;
+        }
+        // An external callee with no body: fine only if it is an AIR intrinsic
+        // (the driver provides it). Anything else is an unresolvable symbol.
+        StringRef name = callee->getName();
+        if (name.starts_with("air."))
+          continue;
+        if (alreadyReported(inst.getLoc()))
+          continue;
+        // Inlining can strip the call-site location; fall back to the enclosing
+        // function, then the kernel, so the error always points somewhere real.
+        SourceLoc loc = inst.getLoc().getSourceLoc();
+        if (loc.isInvalid())
+          loc = fn->getLocation().getSourceLoc();
+        if (loc.isInvalid())
+          loc = kernel->getLocation().getSourceLoc();
+        std::string pretty = Demangle::demangleSymbolAsString(name);
+        Diags.diagnose(loc, diag::gpu_unavailable_symbol,
+                       pretty.empty() ? name : StringRef(pretty));
+        Diags.diagnose(kernel->getLocation().getSourceLoc(),
+                       diag::gpu_reached_from_kernel, kernel->getName(), "");
+      }
+    }
+  }
+
+public:
+  GPUPostOptChecker(DiagnosticEngine &diags) : Diags(diags) {}
+  void run(SILFunction *kernel) { visit(kernel, kernel, /*isEntry=*/true); }
+};
+
+} // end anonymous namespace
+
+void swift::diagnoseGPUUnsafePostOpt(SILModule &M) {
+  llvm::SmallVector<SILFunction *, 4> kernels;
+  collectKernels(M, kernels);
+  if (kernels.empty())
+    return;
+
+  GPUPostOptChecker checker(M.getASTContext().Diags);
+  for (auto *kernel : kernels)
+    checker.run(kernel);
+}
